{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/blog/prefill-decode-memory-wall",
      "destination": "/blog/prefill-decode-and-the-memory-wall",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "github": {
    "silent": true
  }
}
